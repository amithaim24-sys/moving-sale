# =============================================================================
# Vercel environment variables for Moving Sale
# =============================================================================
# DO NOT commit this file after filling it in (it is gitignored).
#
# How to use:
#   Option A — Dashboard (easiest):
#     1. Fill in every value below.
#     2. Vercel project → Settings → Environment Variables → "Import .env"
#        (or paste each KEY=VALUE pair manually).
#     3. For every variable, check ALL three boxes:
#        Production ✓  Preview ✓  Development ✓
#     4. Deployments → Redeploy (uncheck "Use existing Build Cache").
#
#   Option B — Vercel CLI:
#     pnpm dlx vercel link            # link this folder to your Vercel project
#     pnpm dlx vercel env pull        # pull existing env (sanity check)
#     # then push each var:
#     Get-Content .env.vercel.template | ForEach-Object {
#       if ($_ -match '^([A-Z_]+)=(.+)$') {
#         $name, $value = $matches[1], $matches[2].Trim('"')
#         if ($value -and $value -notmatch '^<') {
#           echo $value | pnpm dlx vercel env add $name production
#         }
#       }
#     }
# =============================================================================


# ---------- Database (Neon — free Postgres) ----------
# Get from: https://console.neon.tech → your project → "Connection Details"
# Pick "Pooled connection" and append ?sslmode=require if not already present.
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"


# ---------- NextAuth ----------
# Generate with PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
AUTH_SECRET="<paste-32-char-random-base64-string>"

# Replace <your-app> with your Vercel project subdomain.
# Example: AUTH_URL="https://moving-sale-amithaim24-sys.vercel.app"
AUTH_URL="https://<your-app>.vercel.app"

# Required when NextAuth runs behind Vercel's proxy.
AUTH_TRUST_HOST="true"

# Get from: https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID (Web application). Authorized redirect URI:
#   https://<your-app>.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID="<your-google-client-id>.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="<your-google-client-secret>"


# ---------- Cloudinary (image hosting) ----------
# Get from: https://console.cloudinary.com → Dashboard → "Product Environment Credentials"
CLOUDINARY_CLOUD_NAME="<your-cloud-name>"
CLOUDINARY_API_KEY="<your-api-key>"
CLOUDINARY_API_SECRET="<your-api-secret>"

# NEXT_PUBLIC_* values are exposed to the browser — same cloud name, no secret here.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="<your-cloud-name>"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_FOLDER="moving-sale"
