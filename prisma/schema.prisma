generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role: "USER" | "ADMIN"
// ListingType: "SELL" | "GIVE"
// ListingStatus: "AVAILABLE" | "RESERVED" | "SOLD" | "HIDDEN"

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  whatsappPhone String?
  city          String?
  role          String    @default("USER")
  banned        Boolean   @default(false)
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  items    Item[]
  likes    ItemLike[]

  // People this user has invited to co-manage their items.
  collaborators    Collaborator[] @relation("OwnerCollaborators")
  // Accounts that have invited this user to co-manage their items.
  collaboratingFor Collaborator[] @relation("CollaboratorOf")
  // "Give if unsold" items this user signed up to receive.
  giveIfUnsoldSignups GiveIfUnsoldSignup[]
  // Per-visit log of items this user has viewed (admin analytics).
  itemViews ItemView[]
  // The white-label store this user owns and self-manages, if any. A user owns at
  // most one store; null means they're a regular contributor to the root catalog.
  store Store?
}

// A white-label marketplace carved out of the same app + database. The super-admin
// creates one per customer in the admin panel; it gets a public catalog at
// `/<locale>/s/<slug>` showing only items whose `storeId` points here. The store
// `owner` signs in and self-manages their own items (any item they create is
// auto-filed into their store). A `null` Item.storeId means the item belongs to the
// root/primary catalog (the original moving sale), NOT to any white-label store.
model Store {
  id        String   @id @default(cuid())
  // URL slug used in `/s/<slug>`. Lowercase kebab-case, globally unique.
  slug      String   @unique
  // Display name shown as the catalog heading (e.g. "Dana's Moving Sale").
  name      String
  tagline   String?
  // The user who owns and manages this store. One store per user.
  ownerId   String   @unique
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // When false the public catalog 404s for everyone except the owner/admin
  // (lets you stage a store before sharing the link, or take one offline).
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  items Item[]
}

// Account-level edit sharing: the owner grants a collaborator edit access to ALL
// of the owner's items — existing and any created later.
model Collaborator {
  id             String   @id @default(cuid())
  ownerId        String
  collaboratorId String
  createdAt      DateTime @default(now())

  owner        User @relation("OwnerCollaborators", fields: [ownerId], references: [id], onDelete: Cascade)
  collaborator User @relation("CollaboratorOf", fields: [collaboratorId], references: [id], onDelete: Cascade)

  @@unique([ownerId, collaboratorId])
  @@index([collaboratorId])
}

// A logged-in user registering interest in receiving a "give away if unsold" item
// for free, in place of the WhatsApp contact. The item owner sees these signups.
model GiveIfUnsoldSignup {
  id        String   @id @default(cuid())
  itemId    String
  userId    String
  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([itemId, createdAt])
}

// A future buyer the OWNER manually adds to one of their items — someone who told
// the seller off-site ("let me know when it's free") that they want it once it's
// available. These people have no account; the owner stores their name + phone and
// can later WhatsApp them a "it's ready" message. `notifiedAt` records when the
// owner sent that message, so the list shows who has already been pinged.
model Waitlister {
  id         String    @id @default(cuid())
  itemId     String
  name       String
  phone      String
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Item {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Which white-label store's catalog this item appears in. `null` = the root/primary
  // catalog (the original moving sale). Set automatically at creation from the
  // creator's owned store; an item never appears in more than one store's catalog.
  storeId     String?
  store       Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  title       String
  description String
  type        String   // "SELL" | "GIVE"
  // Optional grouping for browsing/filtering. One of the ITEM_CATEGORIES keys
  // (e.g. "FURNITURE", "KITCHEN"); null means the seller left it unset.
  category    String?
  condition   String?  // "NEW" | "LIKE_NEW" | "USED"
  priceIls    Int?
  previousPriceIls Int?
  // For SELL items only: owner is willing to give it away free if it doesn't sell.
  // When true, buyers see a separate "ask to receive it free" contact button.
  giveIfUnsold Boolean @default(false)
  status      String   @default("AVAILABLE")
  viewCount   Int      @default(0)
  clickCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  images      ItemImage[]
  likes       ItemLike[]
  giveIfUnsoldSignups GiveIfUnsoldSignup[]
  waitlisters Waitlister[]
  views       ItemView[]
  clicks      ItemClick[]

  @@index([status, createdAt])
  @@index([ownerId])
  // Per-store catalog listing: filter by store, then status, newest first.
  @@index([storeId, status, createdAt])
}

// Append-only log of which signed-in user viewed which item, and when. Powers the
// admin analytics ("who viewed what" + views-over-time). Anonymous views are not
// recorded here — only the aggregate Item.viewCount counts those.
model ItemView {
  id        String   @id @default(cuid())
  itemId    String
  userId    String
  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model ItemLike {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId, createdAt])
}

model ItemImage {
  id                 String @id @default(cuid())
  itemId             String
  item               Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  cloudinaryPublicId String
  url                String
  sortOrder          Int    @default(0)

  @@index([itemId, sortOrder])
}

// High-intent click on an item (WhatsApp/contact hand-off). Powers "most clicked item".
model ItemClick {
  id        String   @id @default(cuid())
  itemId    String
  userId    String?
  kind      String   @default("CONTACT") // "CONTACT"
  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
  @@index([kind, createdAt])
  @@index([createdAt])
}

// A visitor who clicked "I want a website like this" on the public catalog. These
// are sales leads the admin follows up with manually — no account is required, so
// the requester may be anonymous (userId is set only if they happened to be signed in).
model WebsiteRequest {
  id        String   @id @default(cuid())
  name      String?
  email     String
  phone     String?
  message   String?
  status    String   @default("NEW") // "NEW" | "HANDLED"
  userId    String?
  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([createdAt])
}

// One row per site visit (page entry), including anonymous visitors keyed by a
// first-party `vid` cookie. Powers "how many users enter" (total + unique).
model Visit {
  id        String   @id @default(cuid())
  visitorId String
  userId    String?
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId, createdAt])
}

// Append-only structured application event log for debugging real user issues
// (e.g. "WhatsApp button did nothing"). Deliberately has NO foreign keys: a log
// row must survive even if the item/user it references is later deleted, and a
// logging failure must never cascade into the request it's describing.
//
// `event`   — what happened, e.g. "whatsapp_contact", "client_error".
// `outcome` — the branch taken, e.g. "redirect_wa" | "no_phone" | "not_logged_in"
//             | "rate_limited" | "banned" | "not_visible" | "popup_blocked" | "error".
// `level`   — "INFO" (normal) | "WARN" (handled-but-notable) | "ERROR" (failure).
// `meta`    — free-form JSON (referer, error stack, request URL, etc.).
model EventLog {
  id        String   @id @default(cuid())
  level     String   @default("INFO")
  event     String
  outcome   String?
  message   String?
  itemId    String?
  userId    String?
  path      String?
  userAgent String?
  ip        String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([event, createdAt])
  @@index([level, createdAt])
}
