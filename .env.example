# Database — Postgres connection string from Neon / Supabase / Vercel Postgres
# Local dev: create a free Neon project at https://neon.tech and paste the URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# NextAuth — REQUIRED in production
AUTH_SECRET=""                           # generate: openssl rand -base64 32
AUTH_URL="http://localhost:3000"         # set to your public URL in production
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Cloudinary — image hosting
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_FOLDER="moving-sale"
